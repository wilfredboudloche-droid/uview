// ===================== RESULTS =====================
function showResults() {
  document.getElementById('game-area').style.display = 'none';
  const rs = document.getElementById('results-screen');
  rs.classList.add('show');
  rs.scrollIntoView({ behavior: 'smooth' });

  const rank = getRank(score);
  const pct = Math.round((score / MAX_SCORE) * 100);

  document.getElementById('results-badge').textContent = rank.emoji;
  document.getElementById('results-rank').textContent = rank.name;
  document.getElementById('results-score').innerHTML = score + ' <span>/ ' + MAX_SCORE + ' pts (' + pct + '%)</span>';

  let msg = '';
  if (pct >= 90) msg = "Outstanding, Cadet! You've achieved <strong>Drive Master</strong> status. You're fully prepared for the Google Workspace Certification exam. Virtue, Vigor, Vision — you've demonstrated all three!";
  else if (pct >= 70) msg = "Great work, Expert! You have a strong grasp of Google Drive management. Review any missed missions and you'll be certification-ready in no time!";
  else if (pct >= 50) msg = "Good effort, Apprentice! You're building solid Drive skills. Focus on the missions you missed — especially search operators and access levels — and retry for a higher rank!";
  else msg = "Keep going, Trainee! Every expert starts somewhere. Review the lesson materials on file formats, search filters, and sharing permissions, then retry the missions!";
  document.getElementById('results-msg').innerHTML = msg;

  const bl = document.getElementById('breakdown-list');
  bl.innerHTML = '';
  for (let i = 1; i <= TOTAL_MISSIONS; i++) {
    const pts = missionScores[i] || 0;
    const div = document.createElement('div');
    div.className = 'breakdown-item';
    div.innerHTML = `<span>${missionNames[i]}</span><span class="bi-pts">+${pts} pts</span>`;
    bl.appendChild(div);
  }

  if (pct >= 80) launchConfetti(80);
  else if (pct >= 60) launchConfetti(40);

  currentMission = TOTAL_MISSIONS;
  updateUI();
}

function restartGame() {
  score = 0; streak = 0; maxStreak = 0; currentMission = 0; missionScores = {};
  document.getElementById('results-screen').classList.remove('show');
  document.getElementById('game-area').style.display = 'block';
  document.querySelectorAll('.mission-card').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.next-btn').forEach(b => b.classList.remove('show'));
  document.querySelectorAll('.feedback-box').forEach(b => { b.classList.remove('show','correct-fb','wrong-fb'); b.innerHTML=''; });
  document.querySelectorAll('.option-btn').forEach(b => { b.disabled=false; b.classList.remove('correct','wrong'); });
  document.getElementById('check-1').disabled = false;
  updateUI();
  initAll();
  goToMission(1);
}

