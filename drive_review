<script>
// ===================== STATE =====================
let score = 0;
let streak = 0;
let maxStreak = 0;
let currentMission = 0;
let missionScores = {};
let missionNames = {
  1: "File Format Sorting",
  2: "Search Ninja",
  3: "Keyboard Shortcuts",
  4: "Naming Conventions",
  5: "Access Levels",
  6: "Sync Methods",
  7: "Final Challenge"
};
const TOTAL_MISSIONS = 7;
const MAX_SCORE = 310;

// ===================== RANKS =====================
function getRank(s) {
  if (s >= 240) return { name: "🏆 Master", emoji: "🏆" };
  if (s >= 160) return { name: "⭐ Expert", emoji: "⭐" };
  if (s >= 80)  return { name: "🔵 Apprentice", emoji: "🔵" };
  return { name: "🎓 Trainee", emoji: "🎓" };
}

function updateUI() {
  document.getElementById('score-display').textContent = score;
  document.getElementById('streak-display').textContent = streak;
  document.getElementById('mission-display').textContent = currentMission + '/' + TOTAL_MISSIONS;
  const pct = (currentMission / TOTAL_MISSIONS) * 100;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-label').textContent = 'Mission ' + currentMission + ' of ' + TOTAL_MISSIONS;
  const rank = getRank(score);
  document.getElementById('rank-display').textContent = rank.name;

  const sb = document.getElementById('streak-badge');
  if (streak >= 3) {
    sb.textContent = '🔥 ' + streak + ' in a row!';
    sb.classList.add('show');
  } else {
    sb.classList.remove('show');
  }
}

function addScore(pts, missionId) {
  score += pts;
  if (!missionScores[missionId]) missionScores[missionId] = 0;
  missionScores[missionId] += pts;
  updateUI();
}

function showToast(msg, type='') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  setTimeout(() => t.classList.remove('show'), 2500);
}

// ===================== CONFETTI =====================
function launchConfetti(count=60) {
  const container = document.getElementById('confetti-container');
  container.innerHTML = '';
  const colors = ['#1B5EAF','#1E7A3E','#F5A623','#E74C3C','#9B59B6','#3498DB','#2ECC71'];
  for (let i = 0; i < count; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.left = Math.random() * 100 + 'vw';
    piece.style.background = colors[Math.floor(Math.random() * colors.length)];
    piece.style.width = (Math.random() * 8 + 6) + 'px';
    piece.style.height = (Math.random() * 8 + 6) + 'px';
    piece.style.animationDuration = (Math.random() * 2 + 1.5) + 's';
    piece.style.animationDelay = (Math.random() * 1) + 's';
    piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    container.appendChild(piece);
    setTimeout(() => piece.remove(), 4000);
  }
}

// ===================== GAME FLOW =====================
function startGame() {
  document.getElementById('intro-screen').classList.add('hide');
  document.getElementById('game-area').classList.add('show');
  goToMission(1);
}

function goToMission(n) {
  document.querySelectorAll('.mission-card').forEach(c => c.classList.remove('active'));
  const card = document.getElementById('mission-' + n);
  if (card) {
    card.classList.add('active');
    card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  currentMission = n;
  updateUI();
}

function handleCorrect(pts, missionId, msg) {
  streak++;
  if (streak > maxStreak) maxStreak = streak;
  addScore(pts, missionId);
  if (streak === 3) { showToast('🔥 3 in a row! Bonus streak!', 'gold'); launchConfetti(30); }
  else if (streak === 5) { showToast('🚀 5 in a row! You\'re on fire!', 'gold'); launchConfetti(60); }
  else { showToast('✅ Correct! +' + pts + ' pts', 'green'); }
  updateUI();
}

function handleWrong() {
  streak = 0;
  updateUI();
  showToast('❌ Not quite — check the feedback!');
}

// ===================== MISSION 1: DRAG & DROP =====================
const fileItems = [
  { id: 'f1', label: '📄 Google Doc', icon: '📄', category: 'native' },
  { id: 'f2', label: '📊 Google Sheet', icon: '📊', category: 'native' },
  { id: 'f3', label: '📽️ Google Slides', icon: '📽️', category: 'native' },
  { id: 'f4', label: '📝 Google Form', icon: '📝', category: 'native' },
  { id: 'f5', label: '📃 Word (.docx)', icon: '📃', category: 'nonnative' },
  { id: 'f6', label: '📈 Excel (.xlsx)', icon: '📈', category: 'nonnative' },
  { id: 'f7', label: '🖼️ Image (.jpg)', icon: '🖼️', category: 'nonnative' },
  { id: 'f8', label: '📑 PDF (.pdf)', icon: '📑', category: 'nonnative' },
];

let draggedItem = null;

function initDrag() {
  const zone = document.getElementById('zone-unsorted');
  fileItems.forEach(item => {
    const el = document.createElement('div');
    el.className = 'drag-item';
    el.id = 'drag-' + item.id;
    el.draggable = true;
    el.dataset.category = item.category;
    el.innerHTML = '<span class="drag-icon">' + item.icon + '</span>' + item.label;
    el.addEventListener('dragstart', e => {
      draggedItem = el;
      setTimeout(() => el.classList.add('dragging'), 0);
    });
    el.addEventListener('dragend', () => {
      el.classList.remove('dragging');
      draggedItem = null;
    });
    zone.appendChild(el);
  });
}

function dragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}
function dragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}
function dropItem(e, zone) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  if (draggedItem) {
    e.currentTarget.appendChild(draggedItem);
  }
}

function checkDrag() {
  const nativeZone = document.getElementById('zone-native');
  const nonNativeZone = document.getElementById('zone-nonnative');
  let correct = 0, total = fileItems.length;

  fileItems.forEach(item => {
    const el = document.getElementById('drag-' + item.id);
    el.classList.remove('correct-place', 'wrong-place');
    const parent = el.parentElement;
    if (item.category === 'native' && parent.id === 'zone-native') {
      el.classList.add('correct-place'); correct++;
    } else if (item.category === 'nonnative' && parent.id === 'zone-nonnative') {
      el.classList.add('correct-place'); correct++;
    } else {
      el.classList.add('wrong-place');
    }
  });

  const fb = document.getElementById('fb-1');
  fb.classList.add('show');
  if (correct === total) {
    fb.className = 'feedback-box show correct-fb';
    fb.innerHTML = '<div class="fb-title">🎉 Perfect Sort! All ' + total + '/' + total + ' correct!</div>Google-native files (Docs, Sheets, Slides, Forms) are stored as metadata only — they use <strong>zero quota</strong>. Non-native files count against your 15 GB limit. This is why converting uploaded Word/Excel files to Google format saves storage!';
    handleCorrect(40, 1, 'Perfect sort!');
    launchConfetti(40);
    document.getElementById('check-1').disabled = true;
    document.getElementById('next-1').classList.add('show');
  } else {
    fb.className = 'feedback-box show wrong-fb';
    fb.innerHTML = '<div class="fb-title">⚠️ ' + correct + '/' + total + ' correct — try again!</div>Hint: Google-native formats are files <em>created inside</em> Google Drive (Docs, Sheets, Slides, Forms). Any file uploaded from outside (Word, Excel, PDF, images) is non-native and uses quota.';
    handleWrong();
  }
}

// ===================== MISSION 2: SEARCH NINJA =====================
const searchQuestions = [
  {
    q: "You need to find all Google Sheets shared with you by your teacher, Ms. Rivera.",
    sim: { text: 'type:spreadsheet owner:ms.rivera@uva.edu', filters: ['type:spreadsheet', 'owner:ms.rivera@uva.edu'] },
    options: [
      { text: 'Use the search bar and type the filename', correct: false },
      { text: 'Filter by type:spreadsheet and owner:ms.rivera@uva.edu', correct: true },
      { text: 'Click "Shared with me" and scroll through all files', correct: false },
      { text: 'Use type:document and from:ms.rivera', correct: false }
    ],
    explanation: 'The <code>type:spreadsheet</code> filter narrows to Sheets, and <code>owner:</code> specifies who created/owns the file. Combining filters is the "Search Ninja" approach!'
  },
  {
    q: "You want to find files modified in the last 7 days that contain the word 'budget'.",
    sim: { text: 'budget after:2024-01-01 before:today', filters: ['after:YYYY-MM-DD', 'before:YYYY-MM-DD', 'keyword'] },
    options: [
      { text: 'Search "budget" and use the date filter in Drive\'s search tools dropdown', correct: true },
      { text: 'Open every recent file and search for "budget" manually', correct: false },
      { text: 'Use type:folder and search "budget"', correct: false },
      { text: 'Check "Recent" tab and look for budget files', correct: false }
    ],
    explanation: 'Drive\'s search tools dropdown (click the filter icon in the search bar) lets you filter by <strong>date modified</strong>. Combined with a keyword, this is the fastest approach!'
  },
  {
    q: "You need to find files that are NOT owned by you — files others have shared with you.",
    sim: { text: 'to:me -owner:me', filters: ['to:me', '-owner:me'] },
    options: [
      { text: 'Click "My Drive" and look for shared icons', correct: false },
      { text: 'Use the "Shared with me" section in the left sidebar', correct: true },
      { text: 'Search type:all and filter by date', correct: false },
      { text: 'Check Google Takeout for shared files', correct: false }
    ],
    explanation: 'The <strong>"Shared with me"</strong> section in Drive\'s left sidebar is the dedicated view for files others have shared with you. You can also use <code>to:me</code> in the search bar!'
  }
];

let searchAnswered = 0;
let searchCorrect = 0;

function initSearchMission() {
  const container = document.getElementById('search-q-container');
  container.innerHTML = '';
  searchAnswered = 0; searchCorrect = 0;
  searchQuestions.forEach((q, qi) => {
    const div = document.createElement('div');
    div.style.marginBottom = '20px';
    div.innerHTML = `
      <div class="scenario-box">
        <div class="scenario-label">🔍 Scenario ${qi+1} of ${searchQuestions.length}</div>
        <p>${q.q}</p>
        <div class="search-sim" style="margin-top:10px;">
          <div class="search-bar"><span class="s-icon">🔍</span><span class="s-text">${q.sim.text}</span></div>
          <div class="search-filter">${q.sim.filters.map(f=>`<span class="sf-chip">${f}</span>`).join('')}</div>
        </div>
      </div>
      <div class="options-grid" id="sq-opts-${qi}">
        ${q.options.map((o,oi)=>`
          <button class="option-btn" onclick="answerSearch(${qi},${oi})" id="sq-${qi}-${oi}">
            <span class="opt-letter">${String.fromCharCode(65+oi)}</span>
            ${o.text}
          </button>`).join('')}
      </div>
      <div class="feedback-box" id="sq-fb-${qi}"></div>
    `;
    container.appendChild(div);
  });
}

function answerSearch(qi, oi) {
  const q = searchQuestions[qi];
  const opts = document.querySelectorAll(`#sq-opts-${qi} .option-btn`);
  opts.forEach(b => b.disabled = true);
  const fb = document.getElementById('sq-fb-' + qi);
  fb.classList.add('show');
  if (q.options[oi].correct) {
    opts[oi].classList.add('correct');
    fb.className = 'feedback-box show correct-fb';
    fb.innerHTML = '<div class="fb-title">✅ Correct!</div>' + q.explanation;
    handleCorrect(15, 2);
    searchCorrect++;
  } else {
    opts[oi].classList.add('wrong');
    q.options.forEach((o,i) => { if(o.correct) opts[i].classList.add('correct'); });
    fb.className = 'feedback-box show wrong-fb';
    fb.innerHTML = '<div class="fb-title">❌ Not quite!</div>' + q.explanation;
    handleWrong();
  }
  searchAnswered++;
  if (searchAnswered === searchQuestions.length) {
    setTimeout(() => document.getElementById('next-2').classList.add('show'), 500);
  }
}

// ===================== MISSION 3: KEYBOARD SHORTCUTS =====================
const shortcuts = [
  { key: '/ (Slash)', action: 'Focus the search bar' },
  { key: 'N', action: 'Rename selected file' },
  { key: 'S', action: 'Star / unstar selected item' },
  { key: 'Shift + Z', action: 'Add shortcut to My Drive' },
  { key: 'Ctrl + Enter', action: 'Open selected item' },
  { key: 'Delete', action: 'Move selected item to Trash' },
];

let selectedShortcut = null;
let matchedPairs = 0;
const shuffledActions = [...shortcuts].sort(() => Math.random() - 0.5);

function initShortcuts() {
  const left = document.getElementById('shortcuts-left');
  const right = document.getElementById('shortcuts-right');
  left.innerHTML = ''; right.innerHTML = '';
  matchedPairs = 0; selectedShortcut = null;

  shortcuts.forEach((s, i) => {
    const btn = document.createElement('div');
    btn.className = 'match-item';
    btn.id = 'sk-left-' + i;
    btn.dataset.index = i;
    btn.innerHTML = '<kbd>' + s.key + '</kbd>';
    btn.onclick = () => selectShortcut(i, btn);
    left.appendChild(btn);
  });

  shuffledActions.forEach((s, i) => {
    const btn = document.createElement('div');
    btn.className = 'match-item';
    btn.id = 'sk-right-' + i;
    btn.dataset.action = s.action;
    btn.textContent = s.action;
    btn.onclick = () => matchAction(s.action, btn);
    right.appendChild(btn);
  });
}

function selectShortcut(idx, btn) {
  if (btn.classList.contains('matched-correct')) return;
  document.querySelectorAll('#shortcuts-left .match-item').forEach(b => b.classList.remove('selected'));
  selectedShortcut = { idx, btn };
  btn.classList.add('selected');
}

function matchAction(action, btn) {
  if (!selectedShortcut) { showToast('👈 First click a shortcut on the left!'); return; }
  if (btn.classList.contains('matched-correct')) return;
  const correct = shortcuts[selectedShortcut.idx].action === action;
  if (correct) {
    selectedShortcut.btn.classList.remove('selected');
    selectedShortcut.btn.classList.add('matched-correct');
    btn.classList.add('matched-correct');
    handleCorrect(15, 3);
    matchedPairs++;
    selectedShortcut = null;
    if (matchedPairs === shortcuts.length) {
      const fb = document.getElementById('fb-3');
      fb.className = 'feedback-box show correct-fb';
      fb.innerHTML = '<div class="fb-title">🎉 All shortcuts matched!</div>You\'ve mastered Google Drive keyboard shortcuts! Remember: press <kbd style="background:var(--blue);color:white;border-radius:4px;padding:2px 6px;">?</kbd> in Drive to see the full shortcut list anytime.';
      launchConfetti(40);
      setTimeout(() => document.getElementById('next-3').classList.add('show'), 500);
    }
  } else {
    btn.classList.add('matched-wrong');
    setTimeout(() => btn.classList.remove('matched-wrong'), 800);
    selectedShortcut.btn.classList.remove('selected');
    selectedShortcut = null;
    handleWrong();
    showToast('❌ Wrong match — try again!');
  }
}

