<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UVA | Mastering the Google Drive Ecosystem</title>
<style>
  :root {
    --blue: #1B5EAF;
    --blue-dark: #134080;
    --blue-light: #d6e4f7;
    --green: #1E7A3E;
    --green-light: #d4edda;
    --gold: #F5A623;
    --red: #C0392B;
    --red-light: #fdecea;
    --white: #ffffff;
    --gray-light: #f4f6fb;
    --gray: #e0e6ef;
    --text: #1a2340;
    --shadow: 0 4px 18px rgba(27,94,175,0.13);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: var(--gray-light);
    color: var(--text);
    min-height: 100vh;
  }

  /* HEADER */
  .header {
    background: var(--blue);
    color: white;
    padding: 0;
    position: relative;
    overflow: hidden;
  }
  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px 10px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .uva-logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .uva-shield {
    width: 48px; height: 56px;
  }
  .uva-name { font-size: 1.1rem; font-weight: 700; line-height: 1.2; }
  .uva-sub { font-size: 0.75rem; opacity: 0.85; }
  .header-title { text-align: center; flex: 1; }
  .header-title h1 { font-size: 1.25rem; font-weight: 800; letter-spacing: 0.5px; }
  .header-title p { font-size: 0.8rem; opacity: 0.85; margin-top: 2px; }
  .rank-badge {
    background: var(--gold);
    color: #1a2340;
    border-radius: 20px;
    padding: 6px 16px;
    font-weight: 800;
    font-size: 0.85rem;
    text-align: center;
    min-width: 110px;
  }
  .rank-badge .rank-label { font-size: 0.65rem; font-weight: 600; opacity: 0.75; display: block; }

  /* MOTTO RIBBON */
  .motto-ribbon {
    background: var(--green);
    color: white;
    text-align: center;
    padding: 6px 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  /* SCORE BAR */
  .score-bar {
    background: var(--blue-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 28px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .score-item { color: white; font-size: 0.82rem; display: flex; align-items: center; gap: 6px; }
  .score-item span { font-weight: 800; font-size: 1rem; color: var(--gold); }
  .streak-badge {
    background: var(--gold);
    color: #1a2340;
    border-radius: 12px;
    padding: 3px 12px;
    font-weight: 800;
    font-size: 0.8rem;
    display: none;
    animation: popIn 0.4s ease;
  }
  .streak-badge.show { display: inline-block; }
  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* PROGRESS BAR */
  .progress-wrap {
    background: var(--blue-dark);
    padding: 0 28px 10px;
  }
  .progress-track {
    background: rgba(255,255,255,0.2);
    border-radius: 10px;
    height: 10px;
    overflow: hidden;
  }
  .progress-fill {
    background: linear-gradient(90deg, var(--gold), #ffcc44);
    height: 100%;
    border-radius: 10px;
    transition: width 0.5s ease;
    width: 0%;
  }
  .progress-label {
    color: rgba(255,255,255,0.75);
    font-size: 0.72rem;
    margin-top: 4px;
    text-align: right;
  }

  /* MAIN CONTENT */
  .main { max-width: 860px; margin: 0 auto; padding: 24px 16px 40px; }

  /* MISSION CARD */
  .mission-card {
    background: white;
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
    margin-bottom: 20px;
    display: none;
    animation: slideIn 0.4s ease;
  }
  .mission-card.active { display: block; }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mission-header {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    color: white;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .mission-icon {
    width: 44px; height: 44px;
    background: rgba(255,255,255,0.18);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .mission-meta { flex: 1; }
  .mission-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.8;
    background: rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 2px 8px;
    display: inline-block;
    margin-bottom: 4px;
  }
  .mission-title { font-size: 1.05rem; font-weight: 800; }
  .mission-pts {
    background: var(--gold);
    color: #1a2340;
    border-radius: 12px;
    padding: 4px 12px;
    font-weight: 800;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .mission-body { padding: 22px; }
  .mission-question {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 16px;
    line-height: 1.5;
    color: var(--text);
  }
  .mission-context {
    background: var(--blue-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
    font-size: 0.85rem;
    margin-bottom: 16px;
    line-height: 1.5;
  }

  /* OPTIONS */
  .options-grid {
    display: grid;
    gap: 10px;
  }
  .option-btn {
    background: var(--gray-light);
    border: 2px solid var(--gray);
    border-radius: 10px;
    padding: 12px 16px;
    text-align: left;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    width: 100%;
  }
  .option-btn:hover:not(:disabled) {
    border-color: var(--blue);
    background: var(--blue-light);
    transform: translateX(3px);
  }
  .option-btn .opt-letter {
    width: 28px; height: 28px;
    background: var(--blue);
    color: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800;
    font-size: 0.8rem;
    flex-shrink: 0;
  }
  .option-btn.correct {
    background: var(--green-light);
    border-color: var(--green);
    color: var(--green);
  }
  .option-btn.correct .opt-letter { background: var(--green); }
  .option-btn.wrong {
    background: var(--red-light);
    border-color: var(--red);
    color: var(--red);
  }
  .option-btn.wrong .opt-letter { background: var(--red); }
  .option-btn:disabled { cursor: default; }

  /* DRAG AND DROP */
  .drag-area {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .drag-column {
    flex: 1;
    min-width: 200px;
  }
  .drag-column h4 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    padding: 6px 10px;
    border-radius: 6px;
    color: white;
  }
  .drag-column.col-native h4 { background: var(--blue); }
  .drag-column.col-nonnative h4 { background: var(--green); }
  .drag-column.col-quota h4 { background: #7B2D8B; }
  .drop-zone {
    min-height: 120px;
    border: 2px dashed var(--gray);
    border-radius: 10px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.2s, background 0.2s;
  }
  .drop-zone.drag-over {
    border-color: var(--blue);
    background: var(--blue-light);
  }
  .drag-item {
    background: white;
    border: 2px solid var(--gray);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.85rem;
    cursor: grab;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
    user-select: none;
  }
  .drag-item:hover { border-color: var(--blue); box-shadow: 0 2px 8px rgba(27,94,175,0.15); }
  .drag-item.dragging { opacity: 0.4; }
  .drag-item .drag-icon { font-size: 1rem; }
  .drag-item.correct-place { border-color: var(--green); background: var(--green-light); }
  .drag-item.wrong-place { border-color: var(--red); background: var(--red-light); }

  /* SHORTCUT MATCHING */
  .match-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .match-left, .match-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .match-item {
    background: var(--gray-light);
    border: 2px solid var(--gray);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
  }
  .match-item:hover { border-color: var(--blue); background: var(--blue-light); }
  .match-item.selected { border-color: var(--blue); background: var(--blue-light); font-weight: 700; }
  .match-item.matched-correct { border-color: var(--green); background: var(--green-light); cursor: default; }
  .match-item.matched-wrong { border-color: var(--red); background: var(--red-light); }
  .match-item kbd {
    background: var(--blue);
    color: white;
    border-radius: 4px;
    padding: 2px 7px;
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* SCENARIO */
  .scenario-box {
    background: #f8f9ff;
    border: 2px solid var(--blue-light);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }
  .scenario-box .scenario-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 6px;
  }
  .scenario-box p { font-size: 0.9rem; line-height: 1.6; }

  /* FEEDBACK */
  .feedback-box {
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 14px;
    font-size: 0.88rem;
    line-height: 1.5;
    display: none;
    animation: popIn 0.3s ease;
  }
  .feedback-box.show { display: block; }
  .feedback-box.correct-fb {
    background: var(--green-light);
    border: 2px solid var(--green);
    color: #145228;
  }
  .feedback-box.wrong-fb {
    background: var(--red-light);
    border: 2px solid var(--red);
    color: #7b1a1a;
  }
  .feedback-box .fb-title { font-weight: 800; font-size: 1rem; margin-bottom: 4px; }

  /* NEXT BUTTON */
  .next-btn {
    background: var(--blue);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 16px;
    display: none;
    transition: background 0.2s, transform 0.1s;
  }
  .next-btn:hover { background: var(--blue-dark); transform: translateY(-1px); }
  .next-btn.show { display: inline-flex; align-items: center; gap: 8px; }

  /* CHECK BUTTON */
  .check-btn {
    background: var(--green);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 16px;
    transition: background 0.2s;
  }
  .check-btn:hover { background: #155c2e; }
  .check-btn:disabled { background: var(--gray); cursor: default; }

  /* RESULTS SCREEN */
  #results-screen {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }
  #results-screen.show { display: block; }
  .results-card {
    background: white;
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 40px 30px;
    max-width: 600px;
    margin: 0 auto;
  }
  .results-badge {
    width: 100px; height: 100px;
    background: linear-gradient(135deg, var(--gold), #ffcc44);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 3rem;
    margin: 0 auto 20px;
    box-shadow: 0 6px 24px rgba(245,166,35,0.4);
    animation: popIn 0.5s ease;
  }
  .results-rank {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--blue);
    margin-bottom: 6px;
  }
  .results-score {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text);
    margin: 10px 0;
  }
  .results-score span { font-size: 1.2rem; color: #888; font-weight: 400; }
  .results-msg { font-size: 1rem; color: #555; margin-bottom: 24px; line-height: 1.6; }
  .results-breakdown {
    background: var(--gray-light);
    border-radius: 12px;
    padding: 16px;
    text-align: left;
    margin-bottom: 20px;
  }
  .results-breakdown h4 { font-size: 0.85rem; font-weight: 700; color: var(--blue); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
  .breakdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid var(--gray);
    font-size: 0.85rem;
  }
  .breakdown-item:last-child { border-bottom: none; }
  .breakdown-item .bi-pts { font-weight: 700; color: var(--green); }
  .restart-btn {
    background: var(--blue);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 14px 32px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }
  .restart-btn:hover { background: var(--blue-dark); }

  /* CONFETTI */
  .confetti-container {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
  }
  .confetti-piece {
    position: absolute;
    width: 10px; height: 10px;
    top: -10px;
    animation: confettiFall linear forwards;
    border-radius: 2px;
  }
  @keyframes confettiFall {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
  }

  /* INTRO SCREEN */
  #intro-screen { display: block; }
  #intro-screen.hide { display: none; }
  .intro-card {
    background: white;
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 36px 30px;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .intro-icon { font-size: 3.5rem; margin-bottom: 12px; }
  .intro-card h2 { font-size: 1.5rem; font-weight: 800; color: var(--blue); margin-bottom: 8px; }
  .intro-card p { font-size: 0.92rem; color: #555; line-height: 1.7; margin-bottom: 16px; }
  .mission-list {
    text-align: left;
    background: var(--gray-light);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
  }
  .mission-list li {
    font-size: 0.88rem;
    padding: 5px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--gray);
  }
  .mission-list li:last-child { border-bottom: none; }
  .mission-list .ml-icon { font-size: 1.1rem; }
  .start-btn {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    color: white;
    border: none;
    border-radius: 12px;
    padding: 16px 40px;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(27,94,175,0.3);
  }
  .start-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(27,94,175,0.4); }

  /* GAME AREA */
  #game-area { display: none; }
  #game-area.show { display: block; }

  /* SEARCH UI SIMULATION */
  .search-sim {
    background: white;
    border: 2px solid var(--gray);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 14px;
    font-family: monospace;
    font-size: 0.88rem;
    color: #333;
  }
  .search-sim .search-bar {
    background: var(--gray-light);
    border: 1px solid var(--gray);
    border-radius: 24px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .search-sim .search-bar .s-icon { color: #888; }
  .search-sim .search-bar .s-text { color: var(--blue); font-weight: 600; }
  .search-filter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .sf-chip {
    background: var(--blue-light);
    color: var(--blue);
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: monospace;
  }

  /* ACCESS LEVEL TABLE */
  .access-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin-bottom: 14px;
  }
  .access-table th {
    background: var(--blue);
    color: white;
    padding: 8px 12px;
    text-align: left;
    font-weight: 700;
  }
  .access-table td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--gray);
  }
  .access-table tr:nth-child(even) td { background: var(--gray-light); }
  .access-badge {
    display: inline-block;
    border-radius: 8px;
    padding: 2px 10px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .ab-viewer { background: #e3f2fd; color: #1565c0; }
  .ab-commenter { background: #fff3e0; color: #e65100; }
  .ab-editor { background: #e8f5e9; color: #2e7d32; }
  .ab-owner { background: #fce4ec; color: #c62828; }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .header-top { flex-direction: column; text-align: center; }
    .match-grid { grid-template-columns: 1fr; }
    .drag-area { flex-direction: column; }
    .score-bar { justify-content: center; }
  }

  /* TOAST */
  .toast {
    position: fixed;
    top: 20px;
    right: 20px;
    background: var(--blue-dark);
    color: white;
    border-radius: 12px;
    padding: 12px 20px;
    font-weight: 700;
    font-size: 0.9rem;
    z-index: 10000;
    display: none;
    animation: slideInRight 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  .toast.show { display: block; }
  @keyframes slideInRight {
    from { transform: translateX(100px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  .toast.gold { background: var(--gold); color: #1a2340; }
  .toast.green { background: var(--green); }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="header-top">
    <div class="uva-logo">
      <svg class="uva-shield" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M24 2L4 10V28C4 40 14 50 24 54C34 50 44 40 44 28V10L24 2Z" fill="#F5A623" stroke="white" stroke-width="2"/>
        <path d="M24 8L10 14V28C10 37 17 45 24 48C31 45 38 37 38 28V14L24 8Z" fill="#1B5EAF"/>
        <text x="24" y="34" text-anchor="middle" fill="white" font-size="14" font-weight="900" font-family="Arial">U</text>
      </svg>
      <div>
        <div class="uva-name">University View Academy</div>
        <div class="uva-sub">Computer Tech Literacy</div>
      </div>
    </div>
    <div class="header-title">
      <h1>🚀 Google Drive Mastery</h1>
      <p>Google Workspace Certification Prep</p>
    </div>
    <div class="rank-badge">
      <span class="rank-label">Current Rank</span>
      <span id="rank-display">🎓 Trainee</span>
    </div>
  </div>
  <div class="motto-ribbon">✦ Virtue  ·  Vigor  ·  Vision ✦</div>
  <div class="score-bar">
    <div class="score-item">⭐ Score: <span id="score-display">0</span></div>
    <div class="score-item">🎯 Mission: <span id="mission-display">0/7</span></div>
    <div class="score-item">🔥 Streak: <span id="streak-display">0</span></div>
    <div class="streak-badge" id="streak-badge">🔥 3 in a row!</div>
  </div>
  <div class="progress-wrap">
    <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
    <div class="progress-label" id="progress-label">Mission 0 of 7</div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- CONFETTI -->
<div class="confetti-container" id="confetti-container"></div>

<!-- MAIN -->
<div class="main">

  <!-- INTRO SCREEN -->
  <div id="intro-screen">
    <div class="intro-card">
      <div class="intro-icon">🗂️</div>
      <h2>Drive Mastery: Mission Briefing</h2>
      <p>Welcome, UVA Cadet! Your mission is to master the <strong>Google Drive Ecosystem</strong> — from file formats and search ninja skills to collaboration security and sync strategies. Complete all 7 missions to earn your <strong>Google Workspace Certification</strong> rank!</p>
      <ul class="mission-list">
